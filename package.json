{
  "name": "platinum",
  "version": "0.1.0",
  "description": "Classic Macintosh workbench: emulator, ESP32 bridge, HFS disk tool and remote debugger",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p . && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/test.mjs",
    "docs:hardware": "node scripts/gen-hardware-docs.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "firmware": "node scripts/build-firmware.mjs",
    "oled-preview": "node scripts/oled-preview.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "author": "Marc Martínez Miró",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Marcm2003/platinum",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marcm2003/platinum.git"
  },
  "bugs": "https://github.com/Marcm2003/platinum/issues",
  "keywords": [
    "macintosh",
    "classic-mac",
    "vintage-computing",
    "retro",
    "emulator",
    "hfs",
    "adb",
    "esp32",
    "electron"
  ],
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@serialport/bindings-cpp": "^13.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "productName": "Platinum",
  "build": {
    "appId": "cat.marc.platinum",
    "productName": "Platinum",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "firmware",
        "to": "firmware"
      },
      {
        "from": "mac-agent",
        "to": "mac-agent"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Platinum connects to the Platinum Bridge (ESP32) over Bluetooth LE.",
        "NSLocalNetworkUsageDescription": "Platinum finds and connects to the Platinum Bridge on your local network."
      }
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
